# Kira AI Configuration
KIRA_API_KEY=your_kira_api_key_here
KIRA_API_URL=https://kiraai.vn/api/v1/chat/completions
KIRA_DEFAULT_MODEL=kira-mini-1.0
KIRA_FALLBACK_MODEL=kira-mini-1.0

# Zilliz Cloud Vector Database Configuration
ZILLIZ_ENDPOINT=https://your-instance.serverless.cloud.zilliz.com
ZILLIZ_API_KEY=your_zilliz_api_key_here
ZILLIZ_COLLECTION=hritikai
ZILLIZ_DIMENSION=384

# Bot Behavior & Language Configuration
# Default communication languages are English and Hindi (Hinglish supported)
DEFAULT_SYSTEM_PROMPT=You are a helpful, respectful, and intelligent AI chatbot assistant. Your default languages for communication are English and Hindi (including natural Hinglish). Understand and respond fluently in English, Hindi, or a natural mix of both as requested by the user. Keep your replies concise, helpful, and direct.

# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_NAME="Universal Chatbot API"

# Optional: Set an access token if you want to password-protect your API from unauthorized callers
# Leave empty to allow public access from any project
CLIENT_ACCESS_TOKEN=

# Required to authorize requests to autoupdate.php; use a long, random value
AUTOUPDATE_SECRET_TOKEN=
